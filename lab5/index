<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Бронирование туристических услуг</title>
  <link rel="stylesheet" href="css/styles.css">
</head>
<body>
  <header>
    <h1>Туристическое агентство</h1>
    <p>Система бронирования туристических услуг</p>
  </header>

  <main>
    <!-- Форма добавления бронирования -->
    <section class="panel">
      <h2>Новое бронирование</h2>
      <form id="booking-form">
        <label>
          Тур:
          <input type="text" id="booking-title" placeholder="Например: Египет, Шарм-эль-Шейх" required>
        </label>
        <label>
          Статус:
          <select id="booking-status">
            <option value="new">Новое</option>
            <option value="confirmed">Подтверждено</option>
            <option value="paid">Оплачено</option>
            <option value="cancelled">Отменено</option>
          </select>
        </label>
        <label>
          Приоритет:
          <select id="booking-priority">
            <option value="high">Высокий</option>
            <option value="medium">Средний</option>
            <option value="low">Низкий</option>
          </select>
        </label>
        <button type="submit">Добавить в список</button>
        <p id="form-error" class="error" hidden></p>
      </form>
    </section>

    <!-- Фильтры и поиск -->
    <section class="panel">
      <h2>Фильтры</h2>
      <label>
        Статус:
        <select id="filter-status">
          <option value="">Все</option>
          <option value="new">Новое</option>
          <option value="confirmed">Подтверждено</option>
          <option value="paid">Оплачено</option>
          <option value="cancelled">Отменено</option>
        </select>
      </label>
      <label>
        Поиск:
        <input type="text" id="search-input" placeholder="Поиск по названию тура">
      </label>
      <button type="button" id="load-button">Загрузить с сервера</button>
    </section>

    <!-- Сообщения о состоянии -->
    <p id="info" class="info">Нажмите «Загрузить с сервера»</p>
    <p id="counter" class="counter" hidden>Всего бронирований: 0</p>

    <!-- Таблица бронирований -->
    <table id="bookings-table" hidden>
      <thead>
        <tr>
          <th>Тур</th>
          <th>Статус</th>
          <th>Приоритет</th>
          <th>Действия</th>
        </tr>
      </thead>
      <tbody id="bookings-body"></tbody>
    </table>
  </main>

  <script src="js/mock-api.js"></script>
  <script src="js/mock-data.js"></script>
  <script src="js/app.js"></script>
</body>
</html>
